<!-- Player Data Manager -->
<Item class="Script" referent="RBXBR_PLAYER_DATA">
<Properties>
<ProtectedString name="Source"><![CDATA[--[[
  PlayerDataManager – per-player stats via DataStoreService.
--]]
local Players           = game:GetService("Players")
local DataStoreService  = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local store = DataStoreService:GetDataStore("BRPlayerStats_v3")

local statsEvent = ReplicatedStorage:FindFirstChild("PlayerStatsEvent")
if not statsEvent then
  statsEvent = Instance.new("RemoteEvent")
  statsEvent.Name = "PlayerStatsEvent"
  statsEvent.Parent = ReplicatedStorage
end

local countdown = ReplicatedStorage:FindFirstChild("MatchCountdown")
if not countdown then
  countdown = Instance.new("NumberValue")
  countdown.Name = "MatchCountdown"
  countdown.Value = 60
  countdown.Parent = ReplicatedStorage
end

local sprintEvent = ReplicatedStorage:FindFirstChild("SprintEvent")
if not sprintEvent then
  sprintEvent = Instance.new("RemoteEvent")
  sprintEvent.Name = "SprintEvent"
  sprintEvent.Parent = ReplicatedStorage
end

local function defaultData()
  return { kills=0, wins=0, matches=0, xp=0, xpMax=1000, level=1, history={} }
end

local function loadData(userId)
  local ok, data = pcall(function() return store:GetAsync("pl_"..userId) end)
  if ok and data then
    local d = defaultData()
    for k, v in pairs(data) do d[k] = v end
    return d
  end
  return defaultData()
end

local function saveData(userId, data)
  pcall(function() store:SetAsync("pl_"..userId, data) end)
end

local cache = {}

Players.PlayerAdded:Connect(function(p)
  cache[p.UserId] = loadData(p.UserId)
end)
Players.PlayerRemoving:Connect(function(p)
  if cache[p.UserId] then saveData(p.UserId, cache[p.UserId]) end
  cache[p.UserId] = nil
end)
game:BindToClose(function()
  for uid, d in pairs(cache) do saveData(uid, d) end
end)

local function levelUp(d)
  while d.xp >= d.xpMax do
    d.xp    = d.xp - d.xpMax
    d.level = d.level + 1
    d.xpMax = math.floor(d.xpMax * 1.25)
  end
end

-- ── Direct kill tracking from KillEvent ──────────────────────────────────
local killEvent = ReplicatedStorage:WaitForChild("KillEvent", 15)
if killEvent then
  killEvent.OnServerEvent:Connect(function() end) -- suppress client->server (unused)
  -- KillTracker fires KillEvent:FireClient(killer, killerName, victimName, total)
  -- We also need server-side tracking. Connect via a BindableEvent bridge in
  -- KillTracker, but since KillTracker already fires killEvent to the CLIENT,
  -- we listen here by watching PlayerAdded/CharacterAdded/Humanoid.Died directly.
end

-- Track kills server-side by watching every humanoid death
Players.PlayerAdded:Connect(function(player)
  if not cache[player.UserId] then
    cache[player.UserId] = loadData(player.UserId)
  end
  player.CharacterAdded:Connect(function(character)
    local humanoid = character:WaitForChild("Humanoid", 10)
    if not humanoid then return end
    humanoid.Died:Connect(function()
      local tag = humanoid:FindFirstChild("creator")
      local killer = tag and tag.Value
      if not killer or not killer:IsA("Player") or killer == player then return end
      local d = cache[killer.UserId]
      if not d then return end
      d.kills = d.kills + 1
      d.xp    = d.xp + 50
      levelUp(d)
      statsEvent:FireClient(killer, "UpdateStats", d)
    end)
  end)
end)

statsEvent.OnServerEvent:Connect(function(player, action, value)
  local d = cache[player.UserId]
  if not d then return end

  if action == "GetStats" then
    statsEvent:FireClient(player, "UpdateStats", d)

  elseif action == "MatchEnd" and type(value) == "table" then
    d.matches = d.matches + 1
    if value.won then
      d.wins = d.wins + 1
      d.xp   = d.xp + 500
    else
      d.xp = d.xp + math.max(10, 200 - (value.placement or 30) * 5)
    end
    levelUp(d)
    table.insert(d.history, 1, {
      placement = value.placement or 0,
      kills     = value.kills or 0,
      won       = value.won or false,
      date      = os.date("%b %d"),
    })
    if #d.history > 10 then table.remove(d.history, 11) end
    statsEvent:FireClient(player, "UpdateStats", d)
  end
end)

print("[PlayerDataManager] Loaded.")
]]></ProtectedString>
