<!-- Map Generator -->
<Item class="Script" referent="RBXBR_MAP_GEN">
<Properties>
<ProtectedString name="Source"><![CDATA[--[[
  MapGenerator – vast 4096×4096 PUBG/CODM-style terrain at runtime.
--]]
local Workspace = game:GetService("Workspace")
local Terrain   = Workspace.Terrain
local M = Enum.Material

local function fill(cx, y, cz, sx, sy, sz, mat)
  Terrain:FillBlock(CFrame.new(cx, y, cz), Vector3.new(sx, sy, sz), mat)
end

print("[MapGen] Base ground...")
fill(0, -2, 0, 4096, 4, 4096, M.Grass)
fill(0, 0, 0, 1500, 2, 1500, M.Ground)

print("[MapGen] Military Base NW...")
local mbX, mbZ = -1400, -1400
fill(mbX, 0, mbZ, 600, 2, 600, M.Concrete)
fill(mbX, 1, mbZ, 40, 1, 500, M.SmoothPlastic)
fill(mbX+120, 1, mbZ, 40, 1, 500, M.SmoothPlastic)
for _, o in {{-100,-100},{100,-100},{-100,100},{100,100}} do
  fill(mbX+o[1], 3, mbZ+o[2], 80, 6, 80, M.Concrete)
end

print("[MapGen] City NE...")
local cX, cZ = 1200, -1400
fill(cX, 0, cZ, 800, 2, 800, M.Cobblestone)
for i = 0, 3 do for j = 0, 3 do
  if math.random() > 0.3 then
    fill(cX-300+i*160, math.random(8,25), cZ-300+j*160,
         70, math.random(8,25)*2, 70, M.SmoothPlastic)
  end
end end
fill(cX, 1, cZ, 800, 1, 20, M.Asphalt)
fill(cX, 1, cZ, 20, 1, 800, M.Asphalt)

print("[MapGen] Jungle SW...")
local jX, jZ = -1400, 1200
fill(jX, 0, jZ, 700, 3, 700, M.LeafyGrass)
for _ = 1, 12 do
  fill(jX+math.random(-300,300), math.random(2,8),
       jZ+math.random(-300,300),
       math.random(60,140), math.random(4,14), math.random(60,140), M.Mud)
end

print("[MapGen] Mountains SE...")
local mX, mZ = 1300, 1300
fill(mX, 0, mZ, 700, 3, 700, M.Rock)
for _, p in {{0,0,60},{-180,0,50},{180,0,55},{0,-200,45},{0,200,48}} do
  fill(mX+p[1], p[3]/2, mZ+p[2], 160, p[3], 160, M.Rock)
  fill(mX+p[1], p[3]+5, mZ+p[2], 100, 12, 100, M.Snow)
end

print("[MapGen] Farm W...")
local fX, fZ = -1500, 0
fill(fX, 0, fZ, 500, 2, 500, M.Grass)
for i = -1, 1 do for j = -1, 1 do
  fill(fX+i*120, 1, fZ+j*120, 80, 1, 80, M.Mud)
end end

print("[MapGen] Factory E...")
local facX, facZ = 1500, 0
fill(facX, 0, facZ, 500, 2, 400, M.Concrete)
fill(facX, 2, facZ, 400, 1, 300, M.SmoothPlastic)
for _, ox in {-120, 0, 120} do
  fill(facX+ox, 20, facZ, 20, 40, 20, M.Brick)
end

print("[MapGen] Ocean border...")
local H, W = 2048, 600
fill( H-W/2, -5, 0, W, 10, 4096, M.Water)
fill(-H+W/2, -5, 0, W, 10, 4096, M.Water)
fill(0, -5,  H-W/2, 4096, 10, W, M.Water)
fill(0, -5, -H+W/2, 4096, 10, W, M.Water)

print("[MapGen] Roads...")
fill(0, 1, 0, 20, 1, 2800, M.Asphalt)
fill(0, 1, 0, 2800, 1, 20, M.Asphalt)
fill(mbX/2, 1, mbZ/2, 16, 1, 600, M.Asphalt)
fill(mX/2,  1, mZ/2,  16, 1, 600, M.Asphalt)

print("[MapGen] Done – 4096×4096 world ready.")
]]></ProtectedString>
