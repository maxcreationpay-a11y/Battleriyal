<Item class="LocalScript" referent="RBXBR_SPRINT_SCRIPT">
<Properties>
<ProtectedString name="Source"><![CDATA[--[[
  SprintController v2
  PC  : Hold Left/Right Shift to sprint
  Mobile : Handled by SprintMobileGui button (shares same speed logic via ReplicatedStorage)
--]]
local Players          = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService       = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player    = Players.LocalPlayer
local character = script.Parent
local humanoid  = character:WaitForChild("Humanoid", 10)
if not humanoid then return end

local BASE_SPEED    = 16
local SPRINT_SPEED  = 30
local STAMINA_MAX   = 100
local STAMINA_DRAIN = 20
local STAMINA_REGEN = 12

local stamina   = STAMINA_MAX
local sprinting = false

local sprintEvent = ReplicatedStorage:FindFirstChild("SprintEvent")

local function setSprint(state)
  if state and stamina > 5 then
    sprinting = true
    humanoid.WalkSpeed = SPRINT_SPEED
    if sprintEvent then sprintEvent:FireServer(true) end
  else
    sprinting = false
    humanoid.WalkSpeed = BASE_SPEED
    if sprintEvent then sprintEvent:FireServer(false) end
  end
end

-- PC keyboard
UserInputService.InputBegan:Connect(function(inp, gp)
  if gp then return end
  if inp.KeyCode == Enum.KeyCode.LeftShift or inp.KeyCode == Enum.KeyCode.RightShift then
    setSprint(true)
  end
end)
UserInputService.InputEnded:Connect(function(inp)
  if inp.KeyCode == Enum.KeyCode.LeftShift or inp.KeyCode == Enum.KeyCode.RightShift then
    setSprint(false)
  end
end)

-- Stamina tick
RunService.Heartbeat:Connect(function(dt)
  if sprinting then
    stamina = math.max(0, stamina - STAMINA_DRAIN * dt)
    if stamina <= 0 then setSprint(false) end
  else
    stamina = math.min(STAMINA_MAX, stamina + STAMINA_REGEN * dt)
  end
end)
]]></ProtectedString>
