		<!-- Kill Tracker -->
<Item class="Script" referent="RBXBR_KILL_TRACKER">
<Properties>
<ProtectedString name="Source"><![CDATA[--[[
  KillTracker – server-side kill attribution and broadcasting.

  How it works:
  1. Every time a character spawns, connect to Humanoid.Died
  2. Read the "creator" tag (set by the existing weapons/blaster logic)
  3. If a creator tag exists, fire KillEvent to that player's client
  4. Also increment their DataStore kill count via PlayerStatsEvent
--]]
local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Create KillEvent if not present
local killEvent = ReplicatedStorage:FindFirstChild("KillEvent")
if not killEvent then
  killEvent = Instance.new("RemoteEvent")
  killEvent.Name = "KillEvent"
  killEvent.Parent = ReplicatedStorage
end

-- Create PlayerStatsEvent if not present
local statsEvent = ReplicatedStorage:FindFirstChild("PlayerStatsEvent")
if not statsEvent then
  statsEvent = Instance.new("RemoteEvent")
  statsEvent.Name = "PlayerStatsEvent"
  statsEvent.Parent = ReplicatedStorage
end

-- In-match kill counts [userId] = count
local matchKills = {}

local function onCharacterAdded(character, victim)
  local humanoid = character:WaitForChild("Humanoid", 10)
  if not humanoid then return end

  humanoid.Died:Connect(function()
    -- Look for creator tag (placed by weapon scripts)
    local tag = humanoid:FindFirstChild("creator")
    local killer = tag and tag.Value
    if not killer or not killer:IsA("Player") then return end
    if killer == victim then return end  -- suicide

    -- Update in-match count
    local uid = killer.UserId
    matchKills[uid] = (matchKills[uid] or 0) + 1
    local newTotal = matchKills[uid]

    -- Notify killer's client
    killEvent:FireClient(killer, killer.Name, victim.Name, newTotal)

    -- NOTE: addKill is handled directly in PlayerDataManager via KillEvent listener
  end)
end

Players.PlayerAdded:Connect(function(player)
  matchKills[player.UserId] = 0
  player.CharacterAdded:Connect(function(char)
    onCharacterAdded(char, player)
  end)
  -- Handle character already loaded
  if player.Character then
    onCharacterAdded(player.Character, player)
  end
end)

Players.PlayerRemoving:Connect(function(player)
  matchKills[player.UserId] = nil
end)

print("[KillTracker] Running – kill attribution active.")
]]></ProtectedString>
