<token name="RunContext">1</token>
<string name="ScriptGuid">{MATCHMAKING-MGR-0000-000000000001}</string>
<BinaryString name="AttributesSerialize"></BinaryString>
<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
<bool name="DefinesCapabilities">false</bool>
<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
<string name="Name">MatchmakingManager</string>
<int64 name="SourceAssetId">-1</int64>
<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
<UniqueId name="UniqueId">aabr000000000000_matchmaking</UniqueId>
</Properties>
</Item>
<!-- Bot Manager – advanced AI bots that fill empty match slots -->
<Item class="Script" referent="RBXBR_BOT_MANAGER">
<Properties>
<ProtectedString name="Source"><![CDATA[--[[
  BotManager – Advanced AI bots that fill empty match slots.

  Bot AI states:
    ROAMING       – wander randomly inside the safe zone
    CHASING       – sprint toward a detected enemy
    COMBAT        – engage at close range (shoot every BOT_SHOOT_INTERVAL seconds)
    EVADING_STORM – flee toward safe-zone centre (overrides all other states)
    TAKING_COVER  – strafe/sidestep after taking a hit to break line of sight

  Integration:
    • MatchmakingManager fires SpawnBotsSignal(count) to spawn bots
    • BattleRoyaleMain reads BotAliveCount (IntValue in brFolder) via getAliveCount()
    • On MatchEndSignal, all bot models are destroyed and counts reset
--]]

local Players            = game:GetService("Players")
local ReplicatedStorage  = game:GetService("ReplicatedStorage")
local RunService         = game:GetService("RunService")
local Workspace          = game:GetService("Workspace")
local Debris             = game:GetService("Debris")

-- ===================== CONFIG =====================
local BOT_HEALTH          = 100
local BOT_WALK_SPEED      = 14
local BOT_RUN_SPEED       = 22
local BOT_DETECT_RADIUS   = 130   -- studs: vision range
local BOT_COMBAT_RADIUS   = 55    -- studs: open fire
local BOT_DISENGAGE_DIST  = 160   -- studs: give up chase
local BOT_SHOOT_DAMAGE    = 12    -- HP per bullet
local BOT_SHOOT_INTERVAL  = 0.75  -- seconds between shots
local BOT_THINK_INTERVAL  = 0.35  -- AI tick rate (seconds)
local BOT_ROAM_INTERVAL   = 9     -- seconds before picking a new roam point
local BOT_COVER_DURATION  = 2.5   -- seconds spent in TAKING_COVER state
local BOT_AIM_JITTER      = 4     -- studs: random offset on target position (miss chance)
local BOT_HIT_REACT_CHANCE= 0.6   -- probability a bot enters cover state when hit
local MAX_BOTS            = 49    -- hard cap

-- Difficulty tiers applied randomly per bot at spawn
local DIFFICULTY = {
  {label="Easy",   aimJitter=8,  shootInterval=1.2, detectRadius=90,  dmg=8 },
  {label="Normal", aimJitter=4,  shootInterval=0.75,detectRadius=130, dmg=12},
  {label="Hard",   aimJitter=1.5,shootInterval=0.45,detectRadius=170, dmg=18},
}

local BOT_NAMES = {
  "Shadow_X","FrostByte","NightOwl","BlazeFury","IronWolf",
  "CrimsonAce","StormRider","GhostPeak","ViperStrike","DarkMatter",
  "SteelEcho","NeonGhost","SilentBolt","OmegaHunt","ApexPhantom",
  "ChaosEdge","VoidRunner","TitanFall","SwiftKill","DeathWave",
  "RubyFang","CobraPit","NovaStar","ArcticWolf","ShadowBlade",
  "PeakReaper","LunaWrath","ZeroFrost","CipherGun","HexStorm",
  "IceBlink","ObsidianX","QuantumAce","RadiantKill","SpecterOne",
  "ToxicPulse","UltraShade","ValorBolt","WyrmFang","XenonDusk",
}

-- ===================== STATE =====================
local activeBots    = {}   -- array of bot tables
local botAliveCount = 0
local usedNames     = {}
local botIdCounter  = 0

-- ===================== SIGNALS & SHARED VALUES =====================
local brFolder = ReplicatedStorage:WaitForChild("BattleRoyale", 60)

-- IntValue read by BattleRoyaleMain to include bots in alive count
local botAliveValue      = Instance.new("IntValue")
botAliveValue.Name       = "BotAliveCount"
botAliveValue.Value      = 0
botAliveValue.Parent     = brFolder

-- BindableEvent fired by MatchmakingManager
local spawnBotsSignal    = Instance.new("BindableEvent")
spawnBotsSignal.Name     = "SpawnBotsSignal"
spawnBotsSignal.Parent   = brFolder

-- BindableEvent fired by BattleRoyaleMain after match ends
local cleanupBotsSignal  = Instance.new("BindableEvent")
cleanupBotsSignal.Name   = "CleanupBotsSignal"
cleanupBotsSignal.Parent = brFolder

-- ===================== HELPERS =====================
local function getBotName()
  local avail = {}
  for _, n in ipairs(BOT_NAMES) do
    if not usedNames[n] then avail[#avail+1] = n end
  end
  local name = #avail > 0 and avail[math.random(#avail)] or ("Bot_"..math.random(1000,9999))
  usedNames[name] = true
  return name
end

local function randomSpawnPos()
  -- Scatter around map, avoid spawning on top of each other
  local angle  = math.random() * math.pi * 2
  local radius = math.random(80, 700)
  local ox = math.cos(angle) * radius
  local oz = math.sin(angle) * radius
  -- Raycast down from altitude to find ground
  local origin = Vector3.new(ox, 80, oz)
  local result = Workspace:Raycast(origin, Vector3.new(0, -120, 0))
  local gy     = result and (result.Position.Y + 3.5) or 5
  return Vector3.new(ox, gy, oz)
end

local function getStorm()
  -- Prefer live values published by BattleRoyaleMain via StormData folder
  local sd = Workspace:FindFirstChild("StormData")
  if sd then
    local cx  = sd:FindFirstChild("CenterX")  and sd.CenterX.Value  or 0
    local cz  = sd:FindFirstChild("CenterZ")  and sd.CenterZ.Value  or 0
    local rad = sd:FindFirstChild("Radius")   and sd.Radius.Value   or 950
    return cx, cz, rad
  end
  return 0, 0, 950
end

local function inStorm(pos)
  local cx, cz, rad = getStorm()
  local dx, dz = pos.X - cx, pos.Z - cz
  return math.sqrt(dx*dx + dz*dz) > rad
end

local function safeZonePoint()
  local cx, cz, rad = getStorm()
  local a = math.random() * math.pi * 2
  local r = math.random(0, math.max(10, math.floor(rad * 0.55)))
  return Vector3.new(cx + math.cos(a)*r, 0, cz + math.sin(a)*r)
end

local function roamPoint(botHrpPos)
  local cx, cz, rad = getStorm()
  local a = math.random() * math.pi * 2
  local r = math.random(20, math.max(30, math.floor(rad * 0.65)))
  return Vector3.new(cx + math.cos(a)*r, botHrpPos.Y, cz + math.sin(a)*r)
end

-- Returns nearest enemy (player or other bot) table, or nil
local function findNearestEnemy(bot)
  local hrp     = bot.hrp
  local closest = nil
  local minDist = bot.detectRadius

  -- Scan real players
  for _, plr in ipairs(Players:GetPlayers()) do
    local char = plr.Character
    if char then
      local ph  = char:FindFirstChild("HumanoidRootPart")
      local hum = char:FindFirstChild("Humanoid")
      if ph and hum and hum.Health > 0 then
        local d = (ph.Position - hrp.Position).Magnitude
        if d < minDist then
          minDist = d
          closest = { hrp = ph, humanoid = hum, isPlayer = true, player = plr, dist = d }
        end
      end
    end
  end

  -- Scan other bots (bots fight each other when no players nearby)
  for _, other in ipairs(activeBots) do
    if other ~= bot and other.humanoid.Health > 0 then
      local d = (other.hrp.Position - hrp.Position).Magnitude
      if d < minDist then
        minDist = d
        closest = { hrp = other.hrp, humanoid = other.humanoid, isPlayer = false, dist = d }
      end
    end
  end

  return closest, minDist
end

-- ===================== NPC RIG =====================
local function buildBotModel(name, spawnPos, difficulty)
  local model   = Instance.new("Model")
  model.Name    = name

  -- HumanoidRootPart (physics anchor + movement target)
  local hrp = Instance.new("Part")
  hrp.Name         = "HumanoidRootPart"
  hrp.Size         = Vector3.new(2, 2, 1)
  hrp.CFrame       = CFrame.new(spawnPos)
  hrp.Anchored     = false
  hrp.CanCollide   = true
  hrp.Transparency = 1   -- invisible root part
  hrp.Parent       = model

  -- Torso
  local torso = Instance.new("Part")
  torso.Name      = "Torso"
  torso.Size      = Vector3.new(2, 2, 1)
  -- Color by difficulty
  local colours = {Easy=BrickColor.new("Bright green"), Normal=BrickColor.new("Bright blue"), Hard=BrickColor.new("Bright red")}
  torso.BrickColor = colours[difficulty.label] or BrickColor.new("Bright blue")
  torso.CanCollide = false
  local tw = Instance.new("Weld")
  tw.Part0 = hrp; tw.Part1 = torso; tw.C0 = CFrame.new(0,0,0); tw.Parent = hrp
  torso.Parent = model

  -- Head
  local head = Instance.new("Part")
  head.Name      = "Head"
  head.Size      = Vector3.new(2, 1, 1)
  head.BrickColor= BrickColor.new("Light orange")
  head.CanCollide= false
  local hw = Instance.new("Weld")
  hw.Part0 = hrp; hw.Part1 = head; hw.C0 = CFrame.new(0, 1.5, 0); hw.Parent = hrp
  head.Parent = model

  -- Left/Right arms
  for _, side in ipairs({{name="Left Arm",  ox=-1.5}, {name="Right Arm", ox=1.5}}) do
    local arm = Instance.new("Part")
    arm.Name      = side.name
    arm.Size      = Vector3.new(1, 2, 1)
    arm.BrickColor= torso.BrickColor
    arm.CanCollide= false
    local aw = Instance.new("Weld")
    aw.Part0 = hrp; aw.Part1 = arm; aw.C0 = CFrame.new(side.ox, 0, 0); aw.Parent = hrp
    arm.Parent = model
  end

  -- Left/Right legs
  for _, side in ipairs({{name="Left Leg",  ox=-0.5}, {name="Right Leg", ox=0.5}}) do
    local leg = Instance.new("Part")
    leg.Name      = side.name
    leg.Size      = Vector3.new(1, 2, 1)
    leg.BrickColor= BrickColor.new("Medium stone grey")
    leg.CanCollide= false
    local lw = Instance.new("Weld")
    lw.Part0 = hrp; lw.Part1 = leg; lw.C0 = CFrame.new(side.ox, -2, 0); lw.Parent = hrp
    leg.Parent = model
  end

  -- Nametag billboard
  local bg  = Instance.new("BillboardGui")
  bg.Size           = UDim2.new(0, 140, 0, 35)
  bg.StudsOffset    = Vector3.new(0, 3.5, 0)
  bg.AlwaysOnTop    = false
  bg.Parent         = head
  local lbl = Instance.new("TextLabel")
  lbl.Size                 = UDim2.new(1, 0, 1, 0)
  lbl.BackgroundTransparency = 1
  local diffColour = {Easy="[E]", Normal="[N]", Hard="[H]"}
  lbl.Text         = diffColour[difficulty.label].." "..name
  lbl.TextColor3   = difficulty.label == "Hard"
                       and Color3.fromRGB(255,80,80)
                       or difficulty.label == "Easy"
                         and Color3.fromRGB(120,220,120)
                         or Color3.fromRGB(120,180,255)
  lbl.TextScaled   = true
  lbl.Font         = Enum.Font.GothamBold
  lbl.Parent       = bg

  -- Health bar
  local healthBg = Instance.new("Frame")
  healthBg.Size            = UDim2.new(1, 0, 0.2, 0)
  healthBg.Position        = UDim2.new(0, 0, 1, 2)
  healthBg.BackgroundColor3= Color3.fromRGB(60, 60, 60)
  healthBg.BorderSizePixel = 0
  healthBg.Parent          = bg
  local healthBar = Instance.new("Frame")
  healthBar.Name            = "HealthBar"
  healthBar.Size            = UDim2.new(1, 0, 1, 0)
  healthBar.BackgroundColor3= Color3.fromRGB(80, 220, 80)
  healthBar.BorderSizePixel = 0
  healthBar.Parent          = healthBg

  -- Humanoid
  local humanoid = Instance.new("Humanoid")
  humanoid.MaxHealth              = BOT_HEALTH
  humanoid.Health                 = BOT_HEALTH
  humanoid.WalkSpeed              = BOT_WALK_SPEED
  humanoid.DisplayDistanceType    = Enum.HumanoidDisplayDistanceType.None
  humanoid.HealthDisplayDistance  = 0
  humanoid.Parent = model

  model.PrimaryPart = hrp
  model.Parent      = Workspace

  return model, humanoid, hrp, healthBar
end

-- ===================== COMBAT =====================
local function tryShoot(bot, enemy)
  local now = tick()
  if now - bot.lastShot < bot.shootInterval then return false end

  local origin    = bot.hrp.Position + Vector3.new(0, 1.5, 0)
  local targetPos = enemy.hrp.Position + Vector3.new(
    math.random(-bot.aimJitter*10, bot.aimJitter*10) / 10,
    1.5,
    math.random(-bot.aimJitter*10, bot.aimJitter*10) / 10
  )
  local dir  = (targetPos - origin)
  local dist = dir.Magnitude
  if dist > bot.combatRadius + 15 then return false end

  -- Line-of-sight raycast
  local rp = RaycastParams.new()
  rp.FilterDescendantsInstances = {bot.model}
  rp.FilterType = Enum.RaycastFilterType.Exclude
  local hit = Workspace:Raycast(origin, dir.Unit * dist * 1.05, rp)
  local hitModel = hit and hit.Instance and hit.Instance:FindFirstAncestorOfClass("Model")
  local targetModel = enemy.hrp.Parent

  local landed = (not hit) or (hitModel == targetModel)
  if landed then
    -- Tag for kill credit (nil value = bot kill, no player receives credit)
    local tag = Instance.new("ObjectValue")
    tag.Name   = "creator"
    tag.Value  = nil
    Debris:AddItem(tag, 2)
    tag.Parent = enemy.humanoid

    enemy.humanoid:TakeDamage(bot.dmg)
    bot.lastShot = now

    -- Muzzle flash: small part that disappears quickly
    local flash = Instance.new("Part")
    flash.Anchored    = true
    flash.CanCollide  = false
    flash.Size        = Vector3.new(0.5, 0.5, 0.5)
    flash.CFrame      = CFrame.new(origin + dir.Unit * 1)
    flash.BrickColor  = BrickColor.new("Neon orange")
    flash.Material    = Enum.Material.Neon
    flash.Parent      = Workspace
    Debris:AddItem(flash, 0.07)
    return true
  end
  return false
end

-- ===================== BOT THINK =====================
local function thinkBot(bot)
  local hrp      = bot.hrp
  local humanoid = bot.humanoid
  if not hrp.Parent or humanoid.Health <= 0 then return end

  -- Update health bar
  if bot.healthBar and bot.healthBar.Parent then
    bot.healthBar.Size = UDim2.new(math.clamp(humanoid.Health / BOT_HEALTH, 0, 1), 0, 1, 0)
    local hp = humanoid.Health / BOT_HEALTH
    bot.healthBar.BackgroundColor3 = Color3.fromRGB(
      math.floor((1 - hp) * 220 + 35),
      math.floor(hp * 185 + 35),
      35
    )
  end

  -- ── PRIORITY 1: EVADING STORM ──────────────────────────────────────────────
  if inStorm(hrp.Position) then
    bot.state = "EVADING_STORM"
    humanoid.WalkSpeed = BOT_RUN_SPEED
    local pt = safeZonePoint()
    humanoid:MoveTo(Vector3.new(pt.X, hrp.Position.Y, pt.Z))
    return
  end

  -- ── PRIORITY 2: TAKING COVER (post-hit dodge) ─────────────────────────────
  if bot.state == "TAKING_COVER" then
    if tick() - bot.coverStart < BOT_COVER_DURATION then
      -- Sidestep perpendicular to last known threat direction
      if bot.coverDir then
        local dest = hrp.Position + bot.coverDir * 18
        humanoid:MoveTo(Vector3.new(dest.X, hrp.Position.Y, dest.Z))
      end
      return
    else
      bot.state = "ROAMING"
    end
  end

  -- ── PRIORITY 3: ENGAGE / CHASE ────────────────────────────────────────────
  local enemy, eDist = findNearestEnemy(bot)

  if enemy and eDist <= bot.detectRadius then
    if eDist <= bot.combatRadius then
      -- COMBAT: strafe + shoot
      bot.state  = "COMBAT"
      bot.target = enemy
      humanoid.WalkSpeed = BOT_WALK_SPEED  -- slow down to aim better

      -- Rotate toward enemy
      local look = CFrame.lookAt(hrp.Position,
        Vector3.new(enemy.hrp.Position.X, hrp.Position.Y, enemy.hrp.Position.Z))
      hrp.CFrame = look

      -- Strafe slightly to avoid standing still
      local perp = Vector3.new(-look.LookVector.Z, 0, look.LookVector.X)
      local strafe = tick() % 3 < 1.5 and perp or -perp
      local strafePos = hrp.Position + strafe * 6
      humanoid:MoveTo(Vector3.new(strafePos.X, hrp.Position.Y, strafePos.Z))

      tryShoot(bot, enemy)

    elseif eDist <= BOT_DISENGAGE_DIST then
      -- CHASING
      bot.state  = "CHASING"
      bot.target = enemy
      humanoid.WalkSpeed = BOT_RUN_SPEED
      humanoid:MoveTo(enemy.hrp.Position)
    else
      bot.target = nil
      bot.state  = "ROAMING"
    end
  else
    -- ── PRIORITY 4: ROAM ──────────────────────────────────────────────────────
    bot.target = nil
    if bot.state ~= "ROAMING" or (tick() - bot.lastRoamTime) >= BOT_ROAM_INTERVAL then
      bot.state       = "ROAMING"
      bot.lastRoamTime = tick()
      humanoid.WalkSpeed = BOT_WALK_SPEED
      humanoid:MoveTo(roamPoint(hrp.Position))
    end
  end
end

-- ===================== SPAWN A BOT =====================
local function spawnBot()
  if botAliveCount >= MAX_BOTS then return end
  botIdCounter = botIdCounter + 1

  -- Random difficulty weighted toward Normal
  local roll = math.random(100)
  local diff = roll <= 30 and DIFFICULTY[1] or roll <= 75 and DIFFICULTY[2] or DIFFICULTY[3]

  local name    = getBotName()
  local pos     = randomSpawnPos()
  local model, humanoid, hrp, healthBar = buildBotModel(name, pos, diff)

  local bot = {
    model          = model,
    humanoid       = humanoid,
    hrp            = hrp,
    healthBar      = healthBar,
    state          = "ROAMING",
    target         = nil,
    lastShot       = 0,
    lastThink      = 0,
    lastRoamTime   = 0,
    coverStart     = 0,
    coverDir       = nil,
    id             = -botIdCounter,
    -- Per-bot difficulty stats
    aimJitter      = diff.aimJitter,
    shootInterval  = diff.shootInterval,
    detectRadius   = diff.detectRadius,
    combatRadius   = BOT_COMBAT_RADIUS,
    dmg            = diff.dmg,
  }

  -- React to taking damage → enter TAKING_COVER
  humanoid.HealthChanged:Connect(function(newHealth)
    if newHealth < humanoid.MaxHealth and math.random() < BOT_HIT_REACT_CHANCE then
      if bot.state ~= "TAKING_COVER" and bot.state ~= "EVADING_STORM" then
        bot.state      = "TAKING_COVER"
        bot.coverStart = tick()
        -- Pick a random perpendicular direction to strafe
        local fwd = hrp.CFrame.LookVector
        bot.coverDir = math.random() < 0.5
          and Vector3.new(-fwd.Z, 0, fwd.X)
          or  Vector3.new( fwd.Z, 0,-fwd.X)
      end
    end
  end)

  -- Death handler
  humanoid.Died:Connect(function()
    botAliveCount           = math.max(0, botAliveCount - 1)
    botAliveValue.Value     = botAliveCount
    usedNames[name]         = nil   -- free name for next match

    for i, b in ipairs(activeBots) do
      if b == bot then table.remove(activeBots, i); break end
    end

    -- Death ragdoll: briefly unanchor then destroy
    for _, part in ipairs(model:GetDescendants()) do
      if part:IsA("BasePart") then part.Anchored = false end
    end
    Debris:AddItem(model, 5)

    print(string.format("[BotManager] '%s' [%s] eliminated. Bots alive: %d",
      name, diff.label, botAliveCount))
  end)

  table.insert(activeBots, bot)
  botAliveCount           = botAliveCount + 1
  botAliveValue.Value     = botAliveCount

  print(string.format("[BotManager] Spawned '%s' [%s] at (%.0f, %.0f, %.0f)",
    name, diff.label, pos.X, pos.Y, pos.Z))
end

local function spawnBots(count)
  count = math.min(count or 10, MAX_BOTS - botAliveCount)
  for i = 1, count do
    task.wait(0.08)  -- small stagger to avoid physics spike
    pcall(spawnBot)
  end
  print(string.format("[BotManager] Spawn batch done. Total bots alive: %d", botAliveCount))
end

-- ===================== CLEANUP =====================
local function cleanupAllBots()
  for _, bot in ipairs(activeBots) do
    if bot.model and bot.model.Parent then
      bot.model:Destroy()
    end
  end
  activeBots      = {}
  botAliveCount   = 0
  botAliveValue.Value = 0
  usedNames       = {}
  print("[BotManager] All bots cleaned up.")
end

-- ===================== SIGNAL LISTENERS =====================
spawnBotsSignal.Event:Connect(function(count)
  task.spawn(spawnBots, count)
end)

cleanupBotsSignal.Event:Connect(cleanupAllBots)

-- Clean up when match ends (BattleRoyaleMain fires this)
local matchEndSig = brFolder:WaitForChild("MatchEndSignal", 60)
if matchEndSig then
  matchEndSig.Event:Connect(function()
    task.delay(5, cleanupAllBots)  -- 5-second delay so death animations play out
  end)
end

-- ===================== AI HEARTBEAT =====================
RunService.Heartbeat:Connect(function()
  if #activeBots == 0 then return end
  local now = tick()
  for _, bot in ipairs(activeBots) do
    if bot.humanoid.Health > 0 and now - bot.lastThink >= BOT_THINK_INTERVAL then
      bot.lastThink = now
      local ok, err = pcall(thinkBot, bot)
      if not ok then
        -- Per-bot error is silenced to prevent crashing the loop
        -- Uncomment below to debug:
        -- warn("[BotManager] thinkBot error:", err)
      end
    end
  end
end)

print("[BotManager] Loaded – listening for SpawnBotsSignal.")
]]></ProtectedString>
