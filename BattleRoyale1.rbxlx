						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local function validateNumber(number: number): boolean
	-- Make sure this is actually a number
	if typeof(number) ~= "number" then
		return false
	end

	-- Make sure the number is not NaN
	if number ~= number then
		return false
	end

	return true
end

return validateNumber
]]></ProtectedString>
						<string name="ScriptGuid">{2FB55555-6D73-4F38-9810-029D64D21E25}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
