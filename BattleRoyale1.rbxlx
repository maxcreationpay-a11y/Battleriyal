<!-- ════════════════════════════════════════════
     LOBBY + PROFILE CONTROLLER LocalScript
     Key fix: camera lock when on menu pages
     ════════════════════════════════════════════ -->
<Item class="LocalScript" referent="RBXBR_LOBBY_CTRL">
<Properties>
<ProtectedString name="Source"><![CDATA[--[[
  LobbyController v4 — full matchmaking flow
  ─────────────────────────────────────────────
  States:
    LOBBY     → player sees MainMenu; game world hidden
    SEARCHING → MatchmakingPage; queue timer ticking
    COUNTDOWN → CountdownPage; match about to start
    IN_GAME   → all lobby UI off; game HUDs on
--]]
local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService      = game:GetService("TweenService")
local StarterGui        = game:GetService("StarterGui")

local player    = Players.LocalPlayer
local playerGui = player.PlayerGui
local gui       = script.Parent
local camera    = game.Workspace.CurrentCamera

-- ── UI references ─────────────────────────────────────────────────────────
local mainMenu       = gui:WaitForChild("MainMenu")
local lobbyPage      = gui:WaitForChild("LobbyPage")
local profilePage    = gui:WaitForChild("ProfilePage")
local mmPage         = gui:WaitForChild("MatchmakingPage")
local cdPage         = gui:WaitForChild("CountdownPage")

-- Matchmaking page children
local mmModeBadge    = mmPage:WaitForChild("ModeBadge")
local mmSearchLabel  = mmPage:WaitForChild("SearchLabel")
local mmCountLabel   = mmPage:WaitForChild("PlayerCountLabel")
local mmElapsed      = mmPage:WaitForChild("ElapsedLabel")
local mmCancelBtn    = mmPage:WaitForChild("CancelButton")

-- Countdown page children
local cdNumber       = cdPage:WaitForChild("CountdownNumber")
local cdInfo         = cdPage:WaitForChild("InfoLabel")

-- MainMenu mode buttons
local rp             = mainMenu.RightPanel.ButtonGroup
local modeRow        = rp:WaitForChild("ModeRow")
local soloBtn        = modeRow:WaitForChild("SoloButton")
local duoBtn         = modeRow:WaitForChild("DuoButton")
local squadBtn       = modeRow:WaitForChild("SquadButton")

-- ── Remote events ──────────────────────────────────────────────────────────
local statsEvent  = ReplicatedStorage:WaitForChild("PlayerStatsEvent", 15)
local brFolder    = ReplicatedStorage:WaitForChild("BattleRoyale", 30)
local queueEvent  = brFolder and brFolder:WaitForChild("QueueEvent",  15)
local queueStatus = brFolder and brFolder:WaitForChild("QueueStatus", 15)

-- ── Helpers ────────────────────────────────────────────────────────────────
local function setGameHudsVisible(visible)
  for _, name in ipairs({"BattleRoyaleHUD", "KillHud"}) do
    local hud = playerGui:FindFirstChild(name)
    if hud then hud.Enabled = visible end
  end
end

local function setCharacterFrozen(frozen)
  local char = player.Character
  if not char then return end
  local hum = char:FindFirstChildWhichIsA("Humanoid")
  if hum then
    hum.WalkSpeed = frozen and 0 or 16
    hum.JumpPower = frozen and 0 or 50
  end
end

player.CharacterAdded:Connect(function()
  if gui.Enabled then
    task.wait(0.1)
    setCharacterFrozen(true)
  end
end)

local LOBBY_CAM = CFrame.new(Vector3.new(0, 220, 350), Vector3.new(0, 0, 0))

local function enterLobbyCamera()
  camera.CameraType = Enum.CameraType.Scriptable
  TweenService:Create(camera, TweenInfo.new(1.2, Enum.EasingStyle.Sine),
    {CFrame = LOBBY_CAM, FieldOfView = 48}):Play()
end

local function exitLobbyCamera()
  camera.CameraType = Enum.CameraType.Custom
  camera.FieldOfView = 70
end

-- ── Page helpers ───────────────────────────────────────────────────────────
local ALL_PAGES = {mainMenu, lobbyPage, profilePage, mmPage, cdPage}

local function showOnly(target)
  for _, pg in ipairs(ALL_PAGES) do
    pg.Visible = (pg == target)
  end
end

-- ── Enter lobby (call on join and after each match) ────────────────────────
local function enterLobby()
  gui.Enabled = true
  showOnly(mainMenu)
  setGameHudsVisible(false)
  setCharacterFrozen(true)
  enterLobbyCamera()
  if statsEvent then statsEvent:FireServer("GetStats") end
end

local function exitToGame()
  gui.Enabled = false
  showOnly(nil)   -- hide all just in case
  exitLobbyCamera()
  setCharacterFrozen(false)
  setGameHudsVisible(true)
end

-- ── Matchmaking queue ──────────────────────────────────────────────────────
local MODE_LABELS = { solo="👤 SOLO", duo="👥 DUO", squad="🛡 SQUAD" }
local MODE_NEEDED = { solo=1, duo=2, squad=4 }
local searchStart = 0
local searchTimer = nil

local function stopSearchTimer()
  if searchTimer then
    searchTimer:Disconnect()
    searchTimer = nil
  end
end

local function joinQueue(mode)
  if not queueEvent then return end
  searchStart = tick()
  mmModeBadge.Text = (MODE_LABELS[mode] or mode):upper()
  mmCountLabel.Text = string.format("Players found: 0 / %d", MODE_NEEDED[mode] or 1)
  mmElapsed.Text = "Time elapsed: 0:00"
  showOnly(mmPage)
  -- Elapsed timer
  stopSearchTimer()
  searchTimer = game:GetService("RunService").Heartbeat:Connect(function()
    local secs = math.floor(tick() - searchStart)
    mmElapsed.Text = string.format("Time elapsed: %d:%02d",
      math.floor(secs/60), secs%60)
  end)
  queueEvent:FireServer({ action="join", mode=mode })
end

local function leaveQueue()
  stopSearchTimer()
  if queueEvent then queueEvent:FireServer({ action="leave" }) end
  showOnly(mainMenu)
end

-- ── QueueStatus handler ────────────────────────────────────────────────────
if queueStatus then
  queueStatus.OnClientEvent:Connect(function(data)
    if not data then return end
    local state = data.state

    if state == "searching" then
      -- Still in queue — update player count
      mmCountLabel.Text = string.format("Players found: %d / %d",
        data.count or 0, data.needed or 1)

    elseif state == "countdown" then
      -- Match found — switch to countdown page
      stopSearchTimer()
      showOnly(cdPage)
      cdNumber.Text = tostring(data.countdown or 5)
      cdInfo.Text   = string.format("🎮 %s  |  %d players entering",
        (MODE_LABELS[data.mode] or data.mode or ""):upper(),
        data.totalPlayers or 1)

    elseif state == "start" then
      -- Game begins now
      stopSearchTimer()
      exitToGame()

    elseif state == "left" then
      -- Server confirmed leave
      showOnly(mainMenu)
    end
  end)
end

-- ── Online badge ───────────────────────────────────────────────────────────
local function updateOnlineBadge()
  mainMenu.LeftStrip.OnlineBadge.Text =
    string.format("👤 Players Online: %d", #Players:GetPlayers())
end
Players.PlayerAdded:Connect(updateOnlineBadge)
Players.PlayerRemoving:Connect(updateOnlineBadge)
updateOnlineBadge()

-- ── Lobby page (player list) ───────────────────────────────────────────────
local function refreshLobby()
  local scroll = lobbyPage.PlayersScrollFrame
  for _, c in scroll:GetChildren() do
    if c:IsA("Frame") then c:Destroy() end
  end
  local all = Players:GetPlayers()
  for _, p in all do
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 44)
    row.BackgroundColor3 = Color3.fromRGB(20, 35, 50)
    row.BackgroundTransparency = 0.3
    row.BorderSizePixel = 0
    row.Name = p.Name
    local corner = Instance.new("UICorner", row)
    corner.CornerRadius = UDim.new(0.08, 0)
    local nameLbl = Instance.new("TextLabel", row)
    nameLbl.Size = UDim2.new(0.6, 0, 1, 0)
    nameLbl.Position = UDim2.new(0.02, 0, 0, 0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLbl.TextSize = 16
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.TextXAlignment = Enum.TextXAlignment.Left
    nameLbl.Text = "👤 " .. p.Name
    local statusLbl = Instance.new("TextLabel", row)
    statusLbl.Size = UDim2.new(0.36, 0, 1, 0)
    statusLbl.Position = UDim2.new(0.62, 0, 0, 0)
    statusLbl.BackgroundTransparency = 1
    statusLbl.TextColor3 = Color3.fromRGB(140, 220, 100)
    statusLbl.TextSize = 13
    statusLbl.Font = Enum.Font.Gotham
    statusLbl.TextXAlignment = Enum.TextXAlignment.Right
    statusLbl.Text = "● In Lobby"
    row.Parent = scroll
  end
  scroll.CanvasSize = UDim2.new(1, 0, 0, #all * 48)
  lobbyPage.MatchInfoBar.MatchModeLabel.Text =
    string.format("🎯 Battle Royale  |  👥 %d online", #all)
end

Players.PlayerAdded:Connect(function()
  updateOnlineBadge()
  if lobbyPage.Visible then refreshLobby() end
end)
Players.PlayerRemoving:Connect(function()
  updateOnlineBadge()
  if lobbyPage.Visible then refreshLobby() end
end)

-- ── Profile page ───────────────────────────────────────────────────────────
local function refreshProfile()
  profilePage.AvatarCard.PlayerNameLabel.Text = player.Name
  if statsEvent then statsEvent:FireServer("GetStats") end
end

if statsEvent then
  statsEvent.OnClientEvent:Connect(function(action, data)
    if action ~= "UpdateStats" then return end
    local pg = profilePage
    pg.StatsGrid.KillsCard.KillsValue.Text    = tostring(data.kills   or 0)
    pg.StatsGrid.WinsCard.WinsValue.Text       = tostring(data.wins    or 0)
    pg.StatsGrid.MatchesCard.MatchesValue.Text = tostring(data.matches or 0)
    local kd = (data.matches and data.matches > 0)
      and string.format("%.2f", (data.kills or 0) / data.matches) or "0.00"
    pg.StatsGrid.KDCard.KDValue.Text  = kd
    pg.AvatarCard.LevelBadge.Text     = "⭐ Lvl " .. tostring(data.level or 1)
    local xpPct = math.clamp((data.xp or 0) / math.max(data.xpMax or 1000, 1), 0, 1)
    pg.XPBarFrame.XPTrack.XPFill.Size = UDim2.new(xpPct, 0, 1, 0)
    pg.XPBarFrame.XPPctLabel.Text     = string.format("%d%%", math.floor(xpPct*100))
    local scroll = pg.MatchHistory.HistoryScrollFrame
    for _, c in scroll:GetChildren() do
      if c:IsA("Frame") then c:Destroy() end
    end
    if data.history then
      for i, m in ipairs(data.history) do
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 36)
        row.BackgroundColor3 = m.won
          and Color3.fromRGB(20, 80, 20) or Color3.fromRGB(80, 20, 20)
        row.BackgroundTransparency = 0.35
        row.BorderSizePixel = 0
        row.Name = "Row" .. i
        local c2 = Instance.new("UICorner", row)
        c2.CornerRadius = UDim.new(0.08, 0)
        local lbl = Instance.new("TextLabel", row)
        lbl.Size = UDim2.new(1, -8, 1, 0)
        lbl.Position = UDim2.new(0, 4, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        lbl.TextSize = 13
        lbl.Font = Enum.Font.Gotham
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Text = string.format("%s  #%d  |  %d kills  |  %s",
          m.won and "🏆" or "💀",
          m.placement or 0, m.kills or 0, m.date or "")
        row.Parent = scroll
      end
      scroll.CanvasSize = UDim2.new(1, 0, 0, #data.history * 40)
    end
  end)
end

-- ── Button wiring ──────────────────────────────────────────────────────────
-- Mode buttons → enter queue
soloBtn.MouseButton1Click:Connect(function()  joinQueue("solo")  end)
duoBtn.MouseButton1Click:Connect(function()   joinQueue("duo")   end)
squadBtn.MouseButton1Click:Connect(function() joinQueue("squad") end)

-- Cancel matchmaking
mmCancelBtn.MouseButton1Click:Connect(leaveQueue)

-- Navigation
rp.LobbyButton.MouseButton1Click:Connect(function()
  showOnly(lobbyPage); refreshLobby()
end)
rp.ProfileButton.MouseButton1Click:Connect(function()
  showOnly(profilePage); refreshProfile()
end)
rp.SettingsButton.MouseButton1Click:Connect(function()
  StarterGui:SetCore("ChatActive", true)
end)
lobbyPage.LobbyHeader.BackButton.MouseButton1Click:Connect(function()
  showOnly(mainMenu)
end)
lobbyPage.ReadyButton.MouseButton1Click:Connect(function()
  local btn = lobbyPage.ReadyButton
  local isReady = btn.Text == "✔  READY"
  btn.Text = isReady and "✖  NOT READY" or "✔  READY"
  btn.BackgroundColor3 = isReady
    and Color3.fromRGB(160, 20, 20) or Color3.fromRGB(0, 160, 0)
end)
profilePage.ProfileHeader.BackButton.MouseButton1Click:Connect(function()
  showOnly(mainMenu)
end)

-- ── Startup ────────────────────────────────────────────────────────────────
enterLobby()
]]></ProtectedString>
