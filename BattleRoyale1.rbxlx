<!-- Scope Controller LocalScript (PC right-click + FOV + breath) -->
<Item class="LocalScript" referent="RBXBR_SCOPE_CTRL">
<Properties>
<ProtectedString name="Source"><![CDATA[--[[
  ScopeController
  PC     : Right-click (MouseButton2) to toggle scope
  Mobile : Handled by MobileActionGui ScopeButton
  Effect : FOV tween 70→22, overlay visible, breath sway drains
--]]
local Players          = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService     = game:GetService("TweenService")
local RunService       = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player    = Players.LocalPlayer
local gui       = script.Parent
local overlay   = gui:WaitForChild("ScopeOverlay")
local breathFill = overlay:FindFirstChild("BreathBar", true)
  and overlay.BreathBar:FindFirstChild("BreathFill")

local camera    = game.Workspace.CurrentCamera
local SCOPED_FOV = 22
local OPEN_FOV   = 70

-- Require CameraRecoiler so its per-frame FOV write uses our scoped FOV.
-- This is the root cause of "scopes out instantly": CameraRecoiler runs on
-- RenderStepped every frame and writes camera.FieldOfView = RECOIL_DEFAULT_FOV,
-- which overrides any tween. setBaseFOV() tells it the correct resting FOV.
local CameraRecoiler
local ok, result = pcall(function()
  return require(ReplicatedStorage:WaitForChild("Blaster"):WaitForChild("CameraRecoiler"))
end)
if ok then CameraRecoiler = result end

local scoped      = false
local breathLevel = 1   -- 0..1 (drains while scoped)
local BREATH_DRAIN = 0.06
local BREATH_REGEN = 0.12

local function setScope(on)
  scoped = on
  overlay.Visible = on
  local targetFOV = on and SCOPED_FOV or OPEN_FOV
  -- Tell CameraRecoiler the correct resting FOV BEFORE tweening
  if CameraRecoiler and CameraRecoiler.setBaseFOV then
    CameraRecoiler.setBaseFOV(targetFOV)
  end
  TweenService:Create(camera,
    TweenInfo.new(0.3, Enum.EasingStyle.Sine),
    { FieldOfView = targetFOV }
  ):Play()
end

-- PC only: right-click toggles scope
if not UserInputService.TouchEnabled then
  UserInputService.InputBegan:Connect(function(inp, gp)
    if gp then return end
    if inp.UserInputType == Enum.UserInputType.MouseButton2 then
      setScope(not scoped)
    end
  end)
end

-- Breath / sway system
RunService.Heartbeat:Connect(function(dt)
  if scoped then
    breathLevel = math.max(0, breathLevel - BREATH_DRAIN * dt)
  else
    breathLevel = math.min(1, breathLevel + BREATH_REGEN * dt)
  end
  if breathFill then
    breathFill.Size = UDim2.new(breathLevel, 0, 1, 0)
    breathFill.BackgroundColor3 = breathLevel > 0.4
      and Color3.fromRGB(50, 220, 80)
      or  Color3.fromRGB(220, 60, 60)
  end
end)
]]></ProtectedString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
