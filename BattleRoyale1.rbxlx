<!-- Matchmaking Manager -->
<Item class="Script" referent="RBXBR_MATCHMAKING_MGR">
<Properties>
<ProtectedString name="Source"><![CDATA[--[[
	MatchmakingManager v2
	- Creates QueueEvent (RemoteEvent) and QueueStatus (RemoteEvent) so clients
	  can join/leave queue by clicking Solo / Duo / Squad mode buttons.
	- Sends periodic QueueStatus updates back to queued players.
	- Runs a countdown (5 s) before firing MatchStartSignal.
	- Bots fill empty slots up to DESIRED_PLAYERS.
--]]

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- ===================== CONFIG =====================
local MIN_PLAYERS     = 1     -- minimum real players to start
local DESIRED_PLAYERS = 15    -- lobby target; bots fill the rest
local FILL_TIMEOUT    = 60    -- seconds before forcing start with bots
local QUEUE_POLL      = 2     -- seconds between status broadcast ticks
local COUNTDOWN_SECS  = 5     -- countdown before match begins

-- ===================== WAIT FOR FOLDER =====================
-- BattleRoyaleMain creates this folder and the BindableEvents at startup.
local brFolder = ReplicatedStorage:WaitForChild("BattleRoyale", 60)
if not brFolder then
	warn("[MatchmakingManager] BattleRoyale folder not found – aborting.")
	return
end
local matchStartSignal = brFolder:WaitForChild("MatchStartSignal", 60)
local matchEndSignal   = brFolder:WaitForChild("MatchEndSignal",   60)

-- ===================== REMOTE EVENTS (client ↔ server) =====================
-- QueueEvent  : client → server  {action="join"|"leave", mode="solo"|"duo"|"squad"}
-- QueueStatus : server → client  {state=..., ...}
local queueEvent = Instance.new("RemoteEvent")
queueEvent.Name   = "QueueEvent"
queueEvent.Parent = brFolder

local queueStatus = Instance.new("RemoteEvent")
queueStatus.Name   = "QueueStatus"
queueStatus.Parent = brFolder

-- ===================== STATE =====================
-- queue[userId] = { player=Player, mode=string }
local queue        = {}
local matchRunning = false

local MODE_NEEDED = { solo = 1, duo = 2, squad = 4 }

-- ===================== HELPERS =====================
local function getQueueList()
	local list = {}
	for _, entry in pairs(queue) do
		list[#list + 1] = entry.player
	end
	return list
end

local function enqueue(player, mode)
	mode = mode or "solo"
	if not queue[player.UserId] then
		queue[player.UserId] = { player = player, mode = mode }
		print(string.format("[Matchmaking] %s joined queue as %s (%d total)",
			player.Name, mode, #getQueueList()))
	end
end

local function dequeue(player)
	if queue[player.UserId] then
		queue[player.UserId] = nil
		print(string.format("[Matchmaking] %s left queue (%d remaining)",
			player.Name, #getQueueList()))
	end
end

local function broadcastStatus(playerList, state, extra)
	-- extra is a table of additional fields merged into the payload
	local needed = MODE_NEEDED[(extra and extra.mode) or "solo"] or 1
	local payload = {
		state        = state,
		count        = #playerList,
		needed       = needed,
	}
	if extra then
		for k, v in pairs(extra) do payload[k] = v end
	end
	for _, p in ipairs(playerList) do
		queueStatus:FireClient(p, payload)
	end
end

local function fillWithBots(realCount)
	local needed = math.max(0, DESIRED_PLAYERS - realCount)
	if needed == 0 then return end
	local spawnSig = brFolder:FindFirstChild("SpawnBotsSignal")
	if spawnSig then
		print(string.format("[Matchmaking] Spawning %d bot(s) to fill lobby.", needed))
		spawnSig:Fire(needed)
	else
		task.delay(3, function()
			local sig = brFolder:FindFirstChild("SpawnBotsSignal")
			if sig then sig:Fire(needed) end
		end)
	end
end

-- ===================== REMOTE EVENT HANDLER =====================
queueEvent.OnServerEvent:Connect(function(player, data)
	if typeof(data) ~= "table" then return end
	local action = data.action
	local mode   = data.mode or "solo"

	if action == "join" then
		if matchRunning then
			-- match already in progress – tell client to wait
			queueStatus:FireClient(player, { state = "waiting", count = 0, needed = 1 })
			return
		end
		enqueue(player, mode)
		-- Immediately acknowledge with current count
		local list = getQueueList()
		broadcastStatus(list, "searching", {
			mode   = mode,
			needed = MODE_NEEDED[mode] or 1,
		})

	elseif action == "leave" then
		dequeue(player)
		queueStatus:FireClient(player, { state = "left" })
	end
end)

-- ===================== PLAYER DISCONNECT =====================
Players.PlayerRemoving:Connect(function(player)
	dequeue(player)
end)

-- ===================== MATCHMAKING LOOP =====================
task.spawn(function()
	while true do
		-- Wait until at least MIN_PLAYERS are in queue
		while #getQueueList() < MIN_PLAYERS do
			task.wait(QUEUE_POLL)
		end

		-- Determine the mode majority vote
		local modeCounts = {}
		local queueSnapshot = {}
		for _, entry in pairs(queue) do
			modeCounts[entry.mode] = (modeCounts[entry.mode] or 0) + 1
			queueSnapshot[#queueSnapshot + 1] = entry
		end
		local majorityMode = "solo"
		local topCount = 0
		for m, c in pairs(modeCounts) do
			if c > topCount then topCount = c; majorityMode = m end
		end

		-- Broadcast "searching" to everyone in queue with updated count
		local list = getQueueList()
		broadcastStatus(list, "searching", {
			mode   = majorityMode,
			needed = DESIRED_PLAYERS,
		})

		-- Fill window: keep broadcasting until timeout or full lobby
		local fillTimer = 0
		while #getQueueList() < DESIRED_PLAYERS and fillTimer < FILL_TIMEOUT do
			task.wait(QUEUE_POLL)
			fillTimer = fillTimer + QUEUE_POLL
			list = getQueueList()
			if #list > 0 then
				broadcastStatus(list, "searching", {
					mode   = majorityMode,
					needed = DESIRED_PLAYERS,
				})
			end
		end

		-- Snapshot and clear queue
		local playerList = getQueueList()
		queue = {}

		if #playerList < MIN_PLAYERS then
			-- Everyone left during fill window
			task.wait(QUEUE_POLL)
		else
			matchRunning = true

			-- Countdown phase: notify clients
			for cd = COUNTDOWN_SECS, 1, -1 do
				broadcastStatus(playerList, "countdown", {
					countdown    = cd,
					mode         = majorityMode,
					totalPlayers = #playerList,
				})
				task.wait(1)
			end

			-- Spawn bots to fill remaining slots
			fillWithBots(#playerList)
			task.wait(1)  -- brief gap for BotManager to register bots

			print(string.format("[Matchmaking] Match starting: %d real players + bots. Mode: %s",
				#playerList, majorityMode))

			-- Tell clients to enter game
			broadcastStatus(playerList, "start", { mode = majorityMode })

			-- Fire MatchStartSignal → BattleRoyaleMain
			matchStartSignal:Fire(playerList, majorityMode)

			-- Wait for match to finish
			matchEndSignal.Event:Wait()
			matchRunning = false
			print("[Matchmaking] Match ended – queue re-opened.")

			-- Cooldown before next round
			task.wait(10)

			-- Re-enqueue players still in the server
			for _, p in ipairs(Players:GetPlayers()) do
				enqueue(p, "solo")
			end
		end
	end
end)

print("[MatchmakingManager] Loaded – QueueEvent and QueueStatus ready.")
]]></ProtectedString>
<bool name="Disabled">false</bool>
