<!-- Battle Royale Main Server Script -->
		<Item class="Script" referent="RBXBR_SERVER_MAIN">
			<Properties>
				<ProtectedString name="Source"><![CDATA[--[[
	BattleRoyaleMain - Server script managing the shrinking storm zone,
	kill tracking, alive count, and win detection for the battle royale.
--]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

-- ===================== CONFIG =====================
local MATCH_WARMUP_TIME = 30   -- seconds before storm starts shrinking
local STORM_PHASES = {
	-- {waitTime, shrinkTime, finalRadius, damagePerSec}
	-- Each phase the storm also drifts its center toward a new random point
	{waitTime = 90,  shrinkTime = 60, finalRadius = 700, damagePerSec = 1 },
	{waitTime = 60,  shrinkTime = 50, finalRadius = 420, damagePerSec = 3 },
	{waitTime = 45,  shrinkTime = 40, finalRadius = 220, damagePerSec = 6 },
	{waitTime = 30,  shrinkTime = 30, finalRadius = 90,  damagePerSec = 12},
	{waitTime = 20,  shrinkTime = 20, finalRadius = 30,  damagePerSec = 25},
}
local STORM_DAMAGE_INTERVAL = 1    -- How often to deal storm damage (seconds)

-- ===================== SETUP =====================
-- Create BattleRoyale folder in ReplicatedStorage for remotes
local brFolder = Instance.new("Folder")
brFolder.Name = "BattleRoyale"
brFolder.Parent = ReplicatedStorage

local updateHUD = Instance.new("RemoteEvent")
updateHUD.Name = "UpdateHUD"
updateHUD.Parent = brFolder

local killEvent = Instance.new("RemoteEvent")
killEvent.Name = "PlayerKilled"
killEvent.Parent = brFolder

local winEvent = Instance.new("RemoteEvent")
winEvent.Name = "PlayerWon"
winEvent.Parent = brFolder

-- MatchmakingManager signals: MatchStartSignal (in) + MatchEndSignal (out)
local matchStartSignal = Instance.new("BindableEvent")
matchStartSignal.Name = "MatchStartSignal"
matchStartSignal.Parent = brFolder

local matchEndSignal = Instance.new("BindableEvent")
matchEndSignal.Name = "MatchEndSignal"
matchEndSignal.Parent = brFolder

-- Kill tracking per player
local killCounts = {}
local alivePlayers = {}

-- Storm zone state
local stormRadius  = 950        -- current safe radius
local stormCenterX = 0
local stormCenterZ = 0
local stormMoving  = false
local currentPhase = 0
local currentDamagePerSec = 1   -- updated each phase

-- ── StormData folder (Workspace) – read by BotManager + StormClientVisuals ──
local stormData = Instance.new("Folder")
stormData.Name  = "StormData"
stormData.Parent = Workspace

local sdCX = Instance.new("NumberValue"); sdCX.Name = "CenterX";  sdCX.Value = 0;   sdCX.Parent = stormData
local sdCZ = Instance.new("NumberValue"); sdCZ.Name = "CenterZ";  sdCZ.Value = 0;   sdCZ.Parent = stormData
local sdR  = Instance.new("NumberValue"); sdR.Name  = "Radius";   sdR.Value  = 950; sdR.Parent  = stormData
local sdPh = Instance.new("IntValue");    sdPh.Name = "Phase";    sdPh.Value = 0;   sdPh.Parent = stormData
local sdMv = Instance.new("BoolValue");   sdMv.Name = "Moving";   sdMv.Value = false; sdMv.Parent = stormData

local function publishStormData()
	sdCX.Value = stormCenterX
	sdCZ.Value = stormCenterZ
	sdR.Value  = stormRadius
	sdPh.Value = currentPhase
	sdMv.Value = stormMoving
end

-- Reference to the StormZone visual part (safe-zone boundary ring)
local stormZonePart = Workspace:WaitForChild("StormZone", 10)

-- Optional danger-zone visual: large opaque slab covering outside the safe zone
-- Created by StormClientVisuals LocalScript on each client, so nothing needed here.

-- ===================== HELPERS =====================
local function updateStormVisual(radius)
	if stormZonePart then
		local diameter = radius * 2
		-- Tall thin wall at the safe-zone edge (looks like a storm boundary)
		stormZonePart.Size = Vector3.new(diameter, 800, diameter)
		stormZonePart.CFrame = CFrame.new(stormCenterX, 200, stormCenterZ)
		-- Pulse colour: bright electric blue border
		stormZonePart.BrickColor  = BrickColor.new("Electric blue")
		stormZonePart.Material    = Enum.Material.Neon
		stormZonePart.Transparency = 0.88
	end
	publishStormData()
end

local function isInsideSafeZone(position)
	local dx = position.X - stormCenterX
	local dz = position.Z - stormCenterZ
	local dist = math.sqrt(dx*dx + dz*dz)
	return dist <= stormRadius
end

local function getAliveCount()
	local count = 0
	for _, _ in pairs(alivePlayers) do count = count + 1 end
	-- Also count living bots managed by BotManager
	local botCountVal = brFolder:FindFirstChild("BotAliveCount")
	if botCountVal then count = count + botCountVal.Value end
	return count
end

local function broadcastHUD(stormTime, moving)
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local inStorm = false
		if character then
			local hrp = character:FindFirstChild("HumanoidRootPart")
			if hrp then
				inStorm = not isInsideSafeZone(hrp.Position)
			end
		end
		local kills = killCounts[player.UserId] or 0
		updateHUD:FireClient(player, {
			aliveCount = getAliveCount(),
			stormTime = stormTime,
			stormMoving = moving or false,
			kills = kills,
			inStorm = inStorm,
		})
	end
end

-- ===================== PLAYER MANAGEMENT =====================
Players.PlayerAdded:Connect(function(player)
	killCounts[player.UserId] = 0
	alivePlayers[player.UserId] = player

	player.CharacterAdded:Connect(function(character)
		local humanoid = character:WaitForChild("Humanoid")

		humanoid.Died:Connect(function()
			-- Remove from alive
			alivePlayers[player.UserId] = nil

			-- Credit kill to killer (via tag)
			local tag = humanoid:FindFirstChild("creator")
			if tag and tag.Value and tag.Value ~= player then
				local killer = tag.Value
				if killCounts[killer.UserId] then
					killCounts[killer.UserId] = killCounts[killer.UserId] + 1
					killEvent:FireClient(killer, player.Name)
				end
			end

			-- Check for win condition
			local alive = getAliveCount()
			if alive == 1 then
				for uid, p in pairs(alivePlayers) do
					winEvent:FireClient(p, killCounts[uid] or 0)
				end
			elseif alive == 0 then
				-- All eliminated — no winner
			end
		end)
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	killCounts[player.UserId] = nil
	alivePlayers[player.UserId] = nil
end)

-- ===================== STORM DAMAGE LOOP =====================
local matchIsActive = false   -- gates storm damage; set true only when a match is running
local lastDamageTime = 0
RunService.Heartbeat:Connect(function(dt)
	if not matchIsActive then return end
	local now = tick()
	if now - lastDamageTime >= STORM_DAMAGE_INTERVAL then
		lastDamageTime = now
		for _, player in ipairs(Players:GetPlayers()) do
			local character = player.Character
			if character then
				local humanoid = character:FindFirstChild("Humanoid")
				local hrp = character:FindFirstChild("HumanoidRootPart")
				if humanoid and hrp and humanoid.Health > 0 then
					if not isInsideSafeZone(hrp.Position) then
						humanoid:TakeDamage(currentDamagePerSec)
					end
				end
			end
		end
	end
end)

-- ===================== STORM SHRINK LOOP =====================
local function lerp(a, b, t) return a + (b - a) * t end

local function runStorm()
	-- Warmup
	updateStormVisual(stormRadius)
	task.wait(MATCH_WARMUP_TIME)

	for phaseIdx, phase in ipairs(STORM_PHASES) do
		currentPhase       = phaseIdx
		currentDamagePerSec = phase.damagePerSec

		-- Each phase: pick a new storm centre within the current safe zone
		-- (simulates the storm closing on a random point, like PUBG)
		local angle       = math.random() * math.pi * 2
		local drift       = math.random(0, math.floor(stormRadius * 0.4))
		local nextCenterX = stormCenterX + math.cos(angle) * drift
		local nextCenterZ = stormCenterZ + math.sin(angle) * drift

		-- Wait phase: safe zone holds still, countdown
		local elapsed = 0
		while elapsed < phase.waitTime do
			task.wait(1)
			elapsed = elapsed + 1
			broadcastHUD(math.ceil(phase.waitTime - elapsed), false)
		end

		-- Shrink phase: radius AND centre smoothly move to new position
		stormMoving = true
		local startRadius  = stormRadius
		local startCX, startCZ = stormCenterX, stormCenterZ
		local targetRadius = phase.finalRadius
		local shrinkElapsed = 0

		while shrinkElapsed < phase.shrinkTime do
			task.wait(0.5)
			shrinkElapsed = shrinkElapsed + 0.5
			local t = math.min(shrinkElapsed / phase.shrinkTime, 1)
			stormRadius  = lerp(startRadius,  targetRadius, t)
			stormCenterX = lerp(startCX,      nextCenterX,  t)
			stormCenterZ = lerp(startCZ,      nextCenterZ,  t)
			updateStormVisual(stormRadius)
			broadcastHUD(0, true)
		end

		stormRadius  = targetRadius
		stormCenterX = nextCenterX
		stormCenterZ = nextCenterZ
		stormMoving  = false
		updateStormVisual(stormRadius)

		print(string.format("[Storm] Phase %d done. Radius=%.0f Centre=(%.0f,%.0f) Dmg=%d/s",
			phaseIdx, stormRadius, stormCenterX, stormCenterZ, currentDamagePerSec))
	end
end

-- ── Wait for MatchmakingManager to signal match start ─────────────────────
local function startNewMatch(playerList, mode)
  -- Reset per-match state
  matchIsActive = true
  stormRadius  = 950
  currentPhase = 0
  stormMoving  = false
  killCounts   = {}
  alivePlayers = {}

  -- Re-populate alive table with matched players
  for _, p in ipairs(playerList) do
    killCounts[p.UserId]   = 0
    alivePlayers[p.UserId] = p
  end

  updateStormVisual(stormRadius)
  broadcastHUD(MATCH_WARMUP_TIME, false)
  print(string.format("[BattleRoyale] Match started – mode=%s players=%d", mode, #playerList))

  -- Run storm (blocking inside its own task)
  runStorm()

  -- Match finished – stop storm damage, signal MatchmakingManager
  matchIsActive = false
  matchEndSignal:Fire()
  print("[BattleRoyale] Match ended.")
end

-- Listen for MatchStartSignal from MatchmakingManager
task.spawn(function()
  local matchSig = brFolder:WaitForChild("MatchStartSignal", 60)
  if not matchSig then
    print("[BattleRoyale] WARNING: MatchStartSignal not found – running standalone.")
    task.spawn(runStorm)
    return
  end
  while true do
    local playerList, mode = matchSig.Event:Wait()
    task.spawn(startNewMatch, playerList or {}, mode or "solo")
  end
end)

print("[BattleRoyale] Server script ready – waiting for MatchmakingManager.")
]]></ProtectedString>
				<bool name="Disabled">false</bool>
