		<!-- Terrain Generation Script — creates a vast realistic landscape -->
		<Item class="Script" referent="RBXBR_TERRAIN_GEN">
			<Properties>
				<ProtectedString name="Source"><![CDATA[--[[
	TerrainGenerator - Procedurally generates a vast, realistic battle royale map
	using Roblox Terrain API with Perlin noise for natural-looking hills and valleys.
	Runs once at server startup.
--]]

local Workspace = game:GetService("Workspace")
local Terrain = Workspace.Terrain

-- ===================== CONFIG =====================
local MAP_SIZE     = 1800    -- Total map width/length in studs
local MAP_HALF     = MAP_SIZE / 2
local CELL_SIZE    = 4       -- Terrain resolution (studs per cell)
local HEIGHT_SCALE = 80      -- Max terrain height variation
local BASE_HEIGHT  = 2       -- Ground base Y level
local WATER_LEVEL  = -8      -- Y level for water bodies

-- Biome noise scales
local MACRO_SCALE  = 0.0008  -- Large landmass shape
local HILL_SCALE   = 0.003   -- Medium hills
local DETAIL_SCALE = 0.012   -- Fine surface detail

-- ===================== MATERIAL MAPPING =====================
local Enum_Material = Enum.Material

local function getMaterial(height, slope)
	if height < WATER_LEVEL + 2 then
		return Enum_Material.Sand
	elseif height < BASE_HEIGHT + 2 then
		return Enum_Material.Grass
	elseif height < BASE_HEIGHT + 20 then
		if slope > 0.6 then
			return Enum_Material.Rock
		else
			return Enum_Material.Grass
		end
	elseif height < BASE_HEIGHT + 50 then
		if slope > 0.5 then
			return Enum_Material.Rock
		else
			return Enum_Material.Mud
		end
	else
		-- High peaks = rock/snow
		return Enum_Material.Rock
	end
end

-- ===================== NOISE FUNCTION =====================
local function noise(x, z, scale, seed)
	-- Roblox's math.noise is Perlin noise
	return math.noise(x * scale + seed, z * scale + seed)
end

local function getHeight(x, z)
	local seed1 = 42.7
	local seed2 = 137.3
	local seed3 = 91.5

	-- Combine multiple octaves
	local macro  = noise(x, z, MACRO_SCALE, seed1) * HEIGHT_SCALE
	local hill   = noise(x, z, HILL_SCALE,  seed2) * (HEIGHT_SCALE * 0.4)
	local detail = noise(x, z, DETAIL_SCALE, seed3) * (HEIGHT_SCALE * 0.1)

	-- Distance-based falloff from center (ensure open playfield near center)
	local dist = math.sqrt(x*x + z*z) / MAP_HALF
	local centerFlat = math.clamp(1 - (1 - dist) * 3, 0, 1)  -- flat near center
	local edgeRidge  = math.clamp((dist - 0.7) * 4, 0, 1)    -- high ridges at edges

	local h = BASE_HEIGHT + (macro + hill + detail) * centerFlat + edgeRidge * HEIGHT_SCALE * 0.8
	return h
end

-- ===================== GENERATION =====================
print("[TerrainGen] Starting terrain generation...")

-- Clear existing terrain
Terrain:Clear()

-- Fill water at the very base
Terrain:FillBlock(
	CFrame.new(0, WATER_LEVEL - 5, 0),
	Vector3.new(MAP_SIZE + 200, 10, MAP_SIZE + 200),
	Enum_Material.Water
)

-- Generate terrain in chunks for performance
local CHUNK = 64  -- cells per chunk side
local steps = math.ceil(MAP_SIZE / CELL_SIZE)
local generated = 0
local totalCells = steps * steps

-- We'll use FillBlock for each cell column
local cellCount = 0
for xi = 0, steps - 1 do
	local wx = -MAP_HALF + xi * CELL_SIZE

	for zi = 0, steps - 1 do
		local wz = -MAP_HALF + zi * CELL_SIZE

		local h = getHeight(wx, wz)
		local hNext_x = getHeight(wx + CELL_SIZE, wz)
		local hNext_z = getHeight(wx, wz + CELL_SIZE)

		-- Approximate slope for material selection
		local slopeX = math.abs(hNext_x - h) / CELL_SIZE
		local slopeZ = math.abs(hNext_z - h) / CELL_SIZE
		local slope  = math.max(slopeX, slopeZ)

		local mat = getMaterial(h, slope)

		-- Fill from water level up to height
		local fillY    = math.max(h, WATER_LEVEL)
		local fillBase = WATER_LEVEL - 2
		local fillHeight = fillY - fillBase

		if fillHeight > 0 then
			Terrain:FillBlock(
				CFrame.new(wx + CELL_SIZE/2, fillBase + fillHeight/2, wz + CELL_SIZE/2),
				Vector3.new(CELL_SIZE, fillHeight, CELL_SIZE),
				mat
			)
		end

		-- Throttle every 500 cells to avoid timeout
		cellCount = cellCount + 1
		if cellCount % 500 == 0 then
			task.wait()
		end
	end

	-- Progress every row
	if xi % 20 == 0 then
		print(string.format("[TerrainGen] Progress: %.1f%%", (xi / steps) * 100))
	end
end

print("[TerrainGen] Terrain generation complete! " .. cellCount .. " cells generated.")

-- Add some large flat landing zones for spawn points
local function flattenArea(cx, cz, radius, yLevel)
	for xi = -radius, radius, CELL_SIZE do
		for zi = -radius, radius, CELL_SIZE do
			if math.sqrt(xi*xi + zi*zi) <= radius then
				Terrain:FillBlock(
					CFrame.new(cx + xi, yLevel - 1, cz + zi),
					Vector3.new(CELL_SIZE, 2, CELL_SIZE),
					Enum_Material.Grass
				)
			end
		end
	end
end

-- Flatten areas around major spawn points
local spawnPoints = {
	{0, 0}, {300, 300}, {-300, 300}, {300, -300}, {-300, -300},
	{600, 0}, {-600, 0}, {0, 600}, {0, -600},
}
for _, sp in ipairs(spawnPoints) do
	flattenArea(sp[1], sp[2], 30, BASE_HEIGHT + 1)
	task.wait()
end

print("[TerrainGen] Spawn zone flattening complete.")
]]></ProtectedString>
