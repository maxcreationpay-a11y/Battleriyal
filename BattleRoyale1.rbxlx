<!-- Mobile action controller LocalScript -->
<Item class="LocalScript" referent="RBXBR_MOBILE_CTRL">
<Properties>
<ProtectedString name="Source"><![CDATA[--[[
  MobileActionController
  • Sprint button: tap+hold → sprint
  • Scope button:  tap toggle → scope overlay + FOV zoom
  Both buttons only appear on touch devices.
--]]
local Players          = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService     = game:GetService("TweenService")

local player = Players.LocalPlayer
local gui    = script.Parent
local sprintBtn = gui:WaitForChild("SprintButton")
local scopeBtn  = gui:WaitForChild("ScopeButton")

-- Only reveal buttons on touch
if UserInputService.TouchEnabled then
  sprintBtn.Visible = true
  scopeBtn.Visible  = true
end

-- ── Sprint ────────────────────────────────────
local function setSprint(on)
  local char = player.Character
  if not char then return end
  local hum = char:FindFirstChildWhichIsA("Humanoid")
  if not hum then return end
  hum.WalkSpeed = on and 30 or 16
  sprintBtn.BackgroundColor3 = on
    and Color3.fromRGB(255, 190, 30)
    or  Color3.fromRGB(30, 100, 30)
  sprintBtn.BackgroundTransparency = on and 0.05 or 0.25
end

sprintBtn.InputBegan:Connect(function(inp)
  if inp.UserInputType == Enum.UserInputType.Touch then setSprint(true) end
end)
sprintBtn.InputEnded:Connect(function(inp)
  if inp.UserInputType == Enum.UserInputType.Touch then setSprint(false) end
end)

-- ── Scope (shared logic with ScopeGui) ───────
-- Also require CameraRecoiler so its per-frame FOV overwrite respects scope zoom
local CameraRecoiler
local okCR, resCR = pcall(function()
  return require(game:GetService("ReplicatedStorage"):WaitForChild("Blaster"):WaitForChild("CameraRecoiler"))
end)
if okCR then CameraRecoiler = resCR end

local scoped = false

local function toggleScope()
  scoped = not scoped
  scopeBtn.BackgroundColor3 = scoped
    and Color3.fromRGB(50, 150, 255)
    or  Color3.fromRGB(20, 20, 80)
  scopeBtn.BackgroundTransparency = scoped and 0.05 or 0.25

  local targetFOV = scoped and 22 or 70
  -- Tell CameraRecoiler the correct resting FOV first
  if CameraRecoiler and CameraRecoiler.setBaseFOV then
    CameraRecoiler.setBaseFOV(targetFOV)
  end

  -- Trigger the shared scope overlay + FOV tween
  local sGui = player.PlayerGui:FindFirstChild("ScopeGui")
  if sGui then
    local overlay = sGui:FindFirstChild("ScopeOverlay")
    if overlay then overlay.Visible = scoped end
    local fov = sGui:FindFirstChild("FOVController")
    if fov then
      TweenService:Create(
        game.Workspace.CurrentCamera,
        TweenInfo.new(0.3, Enum.EasingStyle.Sine),
        { FieldOfView = targetFOV }
      ):Play()
    end
  end
end

scopeBtn.MouseButton1Click:Connect(toggleScope)
]]></ProtectedString>
