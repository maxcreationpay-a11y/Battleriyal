					<float name="BackgroundTransparency">0.5</float>
					<Color3uint8 name="TextColor3">4294901760</Color3uint8>
					<float name="TextSize">28</float>
					<bool name="TextWrapped">true</bool>
					<UDim2 name="Position"><XS>0.5</XS><XO>-200</XO><YS>1</YS><YO>-100</YO></UDim2>
					<UDim2 name="Size"><XS>0</XS><XO>400</XO><YS>0</YS><YO>60</YO></UDim2>
					<string name="Text">⚠ OUTSIDE SAFE ZONE — TAKE COVER!</string>
					<bool name="Visible">false</bool>
					<int name="ZIndex">7</int>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">StormWarning</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">aabr00000000000000000000000016aa</UniqueId>
				</Properties>
			</Item>
			<!-- HUD LocalScript to update values -->
			<Item class="LocalScript" referent="RBXBR_HUD_SCRIPT">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- BattleRoyaleHUD LocalScript
-- Updates the HUD with live player count, storm timer, kills, and storm warning

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local localPlayer = Players.LocalPlayer

-- Wait for GUI elements
local hud = script.Parent
local aliveLabel  = hud:WaitForChild("AliveFrame"):WaitForChild("AliveLabel")
local stormLabel  = hud:WaitForChild("StormFrame"):WaitForChild("StormLabel")
local killsLabel  = hud:WaitForChild("KillsFrame"):WaitForChild("KillsLabel")
local stormWarning = hud:WaitForChild("StormWarning")

-- Local kill counter (updated by KillEvent so it never gets stuck at 0)
local localKills = 0

local function formatTime(seconds)
	if seconds <= 0 then return "NOW" end
	local m = math.floor(seconds / 60)
	local s = seconds % 60
	if m > 0 then
		return string.format("%d:%02d", m, s)
	else
		return string.format("%ds", s)
	end
end

-- Listen to KillEvent fired by the server for this player
local killEvent = ReplicatedStorage:WaitForChild("KillEvent", 30)
if killEvent then
	killEvent.OnClientEvent:Connect(function(killer, killerName, victimName, totalKills)
		-- totalKills is the authoritative count; fall back to incrementing locally
		if totalKills and type(totalKills) == "number" then
			localKills = totalKills
		else
			localKills = localKills + 1
		end
		killsLabel.Text = string.format("☠ Kills: %d", localKills)
	end)
end

-- Wait for BattleRoyale RemoteEvents
local brFolder = ReplicatedStorage:WaitForChild("BattleRoyale", 15)

if brFolder then
	local updateEvent = brFolder:WaitForChild("UpdateHUD", 15)
	if updateEvent then
		updateEvent.OnClientEvent:Connect(function(data)
			-- data: {aliveCount, stormTime, kills, inStorm}
			if data.aliveCount then
				aliveLabel.Text = string.format("👤 Alive: %d", data.aliveCount)
			end
			if data.stormTime then
				if data.stormMoving then
					stormLabel.Text = "⚡ Storm MOVING!"
					stormLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
				else
					stormLabel.Text = string.format("⚡ Storm closes: %s", formatTime(data.stormTime))
					stormLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
				end
			end
			-- Prefer server-authoritative kills if provided
			if data.kills ~= nil then
				localKills = data.kills
				killsLabel.Text = string.format("☠ Kills: %d", localKills)
			end
			if data.inStorm ~= nil then
				stormWarning.Visible = data.inStorm
			end
		end)
	end
end

-- Fallback: update alive count directly from player list
RunService.Heartbeat:Connect(function()
	local count = #Players:GetPlayers()
	aliveLabel.Text = string.format("👤 Alive: %d", count)
end)
]]></ProtectedString>
