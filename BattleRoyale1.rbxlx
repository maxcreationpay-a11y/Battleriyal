			</Properties>
<!-- Storm client visual effects: purple fog + dark sky outside safe zone -->
<Item class="LocalScript" referent="RBXBR_STORM_CLIENT_VFX">
<Properties>
<ProtectedString name="Source"><![CDATA[--[[
  StormClientVisuals
  Reads StormData from Workspace (published by BattleRoyaleMain) and applies
  per-client visual effects that make the storm feel like a real BR game:
    • Outside storm: dark blue-purple ColorCorrection + heavy blur + purple sky
    • Near storm edge (<80 studs): orange warning tint + screen shake
    • Inside storm:  clear sky, no effects
--]]

local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace  = game:GetService("Workspace")
local Lighting   = game:GetService("Lighting")

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

-- ── Lighting effects ──────────────────────────────────────────────────────
local colorCorrect = Instance.new("ColorCorrectionEffect")
colorCorrect.Enabled    = false
colorCorrect.TintColor  = Color3.fromRGB(120, 140, 255)
colorCorrect.Brightness = -0.25
colorCorrect.Saturation = -0.35
colorCorrect.Contrast   = 0.15
colorCorrect.Parent     = Lighting

local blurEffect = Instance.new("BlurEffect")
blurEffect.Enabled = false
blurEffect.Size    = 0
blurEffect.Parent  = Lighting

local warningCorrect = Instance.new("ColorCorrectionEffect")
warningCorrect.Enabled   = false
warningCorrect.TintColor = Color3.fromRGB(255, 160, 60)
warningCorrect.Brightness= -0.1
warningCorrect.Parent    = Lighting

-- Storm edge glow: a large semi-transparent Part that surrounds the storm wall
-- Created locally so it doesn't network to other clients.
local stormWallPart = Instance.new("Part")
stormWallPart.Name         = "LocalStormWall"
stormWallPart.Anchored     = true
stormWallPart.CanCollide   = false
stormWallPart.CastShadow   = false
stormWallPart.Size         = Vector3.new(2000, 900, 2000)
stormWallPart.BrickColor   = BrickColor.new("Dark indigo")
stormWallPart.Material     = Enum.Material.Neon
stormWallPart.Transparency = 0.96
stormWallPart.Shape        = Enum.PartType.Cylinder
stormWallPart.CFrame       = CFrame.new(0, 200, 0)
stormWallPart.Parent       = Workspace

-- Thin glowing ring at the exact safe zone edge (compass ring look)
local edgeRing = Instance.new("Part")
edgeRing.Name        = "LocalEdgeRing"
edgeRing.Anchored    = true
edgeRing.CanCollide  = false
edgeRing.CastShadow  = false
edgeRing.Size        = Vector3.new(1900, 900, 1900)
edgeRing.BrickColor  = BrickColor.new("Electric blue")
edgeRing.Material    = Enum.Material.Neon
edgeRing.Transparency= 0.92
edgeRing.Shape       = Enum.PartType.Cylinder
edgeRing.CFrame      = CFrame.new(0, 200, 0)
edgeRing.Parent      = Workspace

-- ── State ─────────────────────────────────────────────────────────────────
local wasInStorm   = false
local wasNearEdge  = false
local shakeTime    = 0
local lastPulse    = 0

local function lerp(a, b, t) return a + (b - a) * t end

-- ── Tween helpers ──────────────────────────────────────────────────────────
local function tweenBlur(targetSize, dur)
  TweenService:Create(blurEffect,
    TweenInfo.new(dur or 0.8, Enum.EasingStyle.Sine),
    { Size = targetSize }
  ):Play()
end

local function tweenColorCorrect(obj, props, dur)
  TweenService:Create(obj, TweenInfo.new(dur or 0.8, Enum.EasingStyle.Sine), props):Play()
end

-- ── Main loop ──────────────────────────────────────────────────────────────
RunService.RenderStepped:Connect(function(dt)
  local stormData = Workspace:FindFirstChild("StormData")
  if not stormData then return end

  local cx  = stormData:FindFirstChild("CenterX") and stormData.CenterX.Value  or 0
  local cz  = stormData:FindFirstChild("CenterZ") and stormData.CenterZ.Value  or 0
  local rad = stormData:FindFirstChild("Radius")  and stormData.Radius.Value   or 950

  -- Update wall visuals to match current storm centre/radius
  local wallDiam = (rad + 6) * 2
  local ringDiam = rad * 2
  stormWallPart.Size  = Vector3.new(wallDiam, 900, wallDiam)
  stormWallPart.CFrame= CFrame.new(cx, 200, cz)
  edgeRing.Size       = Vector3.new(ringDiam, 920, ringDiam)
  edgeRing.CFrame     = CFrame.new(cx, 200, cz)

  -- Pulse the edge ring brightness
  local now = tick()
  local pulse = 0.5 + 0.5 * math.sin(now * 2.5)
  edgeRing.Transparency = lerp(0.88, 0.96, pulse)

  -- Check player position
  local char = player.Character
  if not char then return end
  local hrp = char:FindFirstChild("HumanoidRootPart")
  if not hrp then return end

  local dx = hrp.Position.X - cx
  local dz = hrp.Position.Z - cz
  local dist = math.sqrt(dx*dx + dz*dz)
  local inStorm  = dist > rad
  local nearEdge = not inStorm and dist > rad - 80

  -- ── Entering storm ────────────────────────────────────────────────────
  if inStorm and not wasInStorm then
    colorCorrect.Enabled   = true
    warningCorrect.Enabled = false
    blurEffect.Enabled     = true
    tweenColorCorrect(colorCorrect, {
      TintColor  = Color3.fromRGB(100, 120, 230),
      Brightness = -0.3, Saturation = -0.5
    }, 1.2)
    tweenBlur(18, 1.5)
    -- Darken sky
    TweenService:Create(Lighting,
      TweenInfo.new(1.5, Enum.EasingStyle.Sine),
      { Brightness = 0.2, OutdoorAmbient = Color3.fromRGB(30,20,80) }
    ):Play()
  end

  -- ── Leaving storm ─────────────────────────────────────────────────────
  if not inStorm and wasInStorm then
    tweenColorCorrect(colorCorrect, {
      TintColor = Color3.fromRGB(255,255,255), Brightness = 0, Saturation = 0
    }, 1.0)
    tweenBlur(0, 1.2)
    TweenService:Create(Lighting,
      TweenInfo.new(1.5, Enum.EasingStyle.Sine),
      { Brightness = 1, OutdoorAmbient = Color3.fromRGB(128,128,128) }
    ):Play()
    task.delay(1.2, function()
      if not inStorm then
        colorCorrect.Enabled = false
        blurEffect.Enabled   = false
      end
    end)
  end

  -- ── Near edge warning ─────────────────────────────────────────────────
  if nearEdge and not wasNearEdge and not inStorm then
    warningCorrect.Enabled = true
    tweenColorCorrect(warningCorrect, { Brightness = -0.12 }, 0.5)
  elseif not nearEdge and wasNearEdge then
    tweenColorCorrect(warningCorrect, { Brightness = 0 }, 0.6)
    task.delay(0.7, function() warningCorrect.Enabled = false end)
  end

  -- ── Screen micro-shake when inside storm ─────────────────────────────
  if inStorm then
    shakeTime = shakeTime + dt
    if shakeTime > 0.08 then
      shakeTime = 0
      local shake = 0.08
      camera.CFrame = camera.CFrame *
        CFrame.Angles(
          math.random(-100,100)/1000 * shake,
          math.random(-100,100)/1000 * shake,
          0
        )
    end
  end

  wasInStorm  = inStorm
  wasNearEdge = nearEdge
end)
]]></ProtectedString>
