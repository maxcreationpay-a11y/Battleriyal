			<Item class="ModuleScript" referent="RBX3F7B71E268E847B39141A6E945FDE756">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local function disconnectAndClear(connections: { RBXScriptConnection })
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
end

return disconnectAndClear
]]></ProtectedString>
