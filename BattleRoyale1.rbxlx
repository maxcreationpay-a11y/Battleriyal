<!-- Kill HUD LocalScript -->
<Item class="LocalScript" referent="RBXBR_KILL_HUD_CTRL">
<Properties>
<ProtectedString name="Source"><![CDATA[--[[
  KillHudController
  Listens for KillEvent from server and:
    1. Increments on-screen kill counter
    2. Shows a kill notification in the feed for 3 s
    3. Flashes the kill chip orange
    4. Shows a small toast banner for kills and deaths
--]]
local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService      = game:GetService("TweenService")

local player = Players.LocalPlayer
local gui    = script.Parent

local chip       = gui:WaitForChild("KillChip")
local killLabel  = chip:WaitForChild("KillCountLabel")
local killFlash  = chip:WaitForChild("KillFlash")
local feed       = gui:WaitForChild("KillFeed")
local toastFrame = gui:WaitForChild("ToastFrame")
local toastLabel = toastFrame:WaitForChild("ToastLabel")

local killCount   = 0
local toastActive = false

-- ── Toast helper ────────────────────────────────────────────────────────────
local function showToast(text, bgColor)
  toastLabel.Text             = text
  toastFrame.BackgroundColor3 = bgColor
  toastFrame.BackgroundTransparency = 0.2
  toastLabel.TextTransparency = 0
  toastFrame.Visible          = true
  toastActive                 = true

  -- Slide in from slightly above, then hold, then fade out
  toastFrame.Position = UDim2.new(0.5, -120, 0, 50)
  TweenService:Create(toastFrame, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
    Position = UDim2.new(0.5, -120, 0, 62)
  }):Play()

  task.delay(2.2, function()
    if not toastActive then return end
    TweenService:Create(toastFrame, TweenInfo.new(0.35), {
      BackgroundTransparency = 1
    }):Play()
    TweenService:Create(toastLabel, TweenInfo.new(0.35), {
      TextTransparency = 1
    }):Play()
    task.delay(0.4, function()
      toastFrame.Visible = false
      toastActive        = false
    end)
  end)
end

-- ── Kill chip flash ─────────────────────────────────────────────────────────
local function flashChip()
  chip.BackgroundColor3 = Color3.fromRGB(220, 60, 10)
  TweenService:Create(chip, TweenInfo.new(0.8, Enum.EasingStyle.Quad), {
    BackgroundColor3 = Color3.fromRGB(0, 0, 0)
  }):Play()
  killFlash.Visible = true
  task.delay(0.4, function() killFlash.Visible = false end)
end

-- ── Kill feed row ────────────────────────────────────────────────────────────
local function addFeedRow(killerName, victimName)
  local row = Instance.new("Frame")
  row.Size = UDim2.new(1, 0, 0, 26)
  row.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
  row.BackgroundTransparency = 0.35
  row.BorderSizePixel = 0
  local corner = Instance.new("UICorner", row)
  corner.CornerRadius = UDim.new(0.15, 0)
  local lbl = Instance.new("TextLabel", row)
  lbl.Size = UDim2.new(1, -8, 1, 0)
  lbl.Position = UDim2.new(0, 4, 0, 0)
  lbl.BackgroundTransparency = 1
  lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
  lbl.TextSize = 14
  lbl.Font = Enum.Font.GothamBold
  lbl.TextXAlignment = Enum.TextXAlignment.Center
  lbl.Text = killerName .. " ☠ " .. victimName
  row.Parent = feed
  task.delay(3, function()
    TweenService:Create(row, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
    TweenService:Create(lbl, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
    task.delay(0.6, function() row:Destroy() end)
  end)
end

-- ── Death detection ──────────────────────────────────────────────────────────
local function watchCharacter(char)
  local hum = char:WaitForChild("Humanoid", 10)
  if not hum then return end
  hum.Died:Connect(function()
    -- Try to read the "creator" tag set by kill scripts
    local tag        = hum:FindFirstChild("creator")
    local killerName = (tag and tag.Value and tag.Value.Name) or "the storm"
    showToast("💀  Eliminated by " .. killerName, Color3.fromRGB(180, 30, 30))
  end)
end

if player.Character then
  task.spawn(watchCharacter, player.Character)
end
player.CharacterAdded:Connect(watchCharacter)

-- ── Kill event ───────────────────────────────────────────────────────────────
local killEvent = ReplicatedStorage:WaitForChild("KillEvent", 30)
if not killEvent then return end

-- Server fires: KillEvent:FireClient(killerName, victimName, totalKills)
killEvent.OnClientEvent:Connect(function(killerName, victimName, newTotal)
  killCount = newTotal or (killCount + 1)
  killLabel.Text = "💀  " .. killCount .. (killCount == 1 and " Kill" or " Kills")
  flashChip()
  addFeedRow(killerName or player.Name, victimName or "Enemy")
  -- Toast only for THIS player's kills
  showToast("☠  Eliminated " .. (victimName or "Enemy"), Color3.fromRGB(30, 140, 60))
end)
]]></ProtectedString>
